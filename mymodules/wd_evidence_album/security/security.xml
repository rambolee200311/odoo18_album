<odoo>
    <record id="group_album_user" model="res.groups">
        <field name="name">WMS Evidence Album User</field>
        <field name="category_id" ref="base.module_category_operations"/>
    </record>

    <record id="group_album_reviewer" model="res.groups">
        <field name="name">WMS Evidence Album Reviewer</field>
        <field name="category_id" ref="base.module_category_operations"/>
        <field name="implied_ids" eval="[(4, ref('group_album_user'))]"/>
    </record>

    <record id="group_album_manager" model="res.groups">
        <field name="name">WMS Evidence Album Manager</field>
        <field name="category_id" ref="base.module_category_operations"/>
        <field name="implied_ids" eval="[(4, ref('group_album_reviewer'))]"/>
    </record>

    <record id="rule_album_user_own" model="ir.rule">
        <field name="name">Evidence Album: own albums</field>
        <field name="model_id" ref="model_wd_evidence_album"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_album_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_album_reviewer_all" model="ir.rule">
        <field name="name">Evidence Album: reviewer access</field>
        <field name="model_id" ref="model_wd_evidence_album"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_album_reviewer'))]"/>
    </record>

    <record id="rule_album_manager_all" model="ir.rule">
        <field name="name">Evidence Album: manager access</field>
        <field name="model_id" ref="model_wd_evidence_album"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_album_manager'))]"/>
    </record>

    <record id="rule_page_user_own_album" model="ir.rule">
        <field name="name">Evidence Album Page: own album</field>
        <field name="model_id" ref="model_wd_evidence_album_page"/>
        <field name="domain_force">[('album_id.create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_album_user'))]"/>
    </record>

    <record id="rule_page_reviewer_all" model="ir.rule">
        <field name="name">Evidence Album Page: reviewer access</field>
        <field name="model_id" ref="model_wd_evidence_album_page"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_album_reviewer'))]"/>
    </record>

    <record id="rule_page_manager_all" model="ir.rule">
        <field name="name">Evidence Album Page: manager access</field>
        <field name="model_id" ref="model_wd_evidence_album_page"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_album_manager'))]"/>
    </record>

    <record id="rule_item_user_own_album" model="ir.rule">
        <field name="name">Evidence Album Item: own album</field>
        <field name="model_id" ref="model_wd_evidence_album_item"/>
        <field name="domain_force">[('album_id.create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_album_user'))]"/>
    </record>

    <record id="rule_item_reviewer_all" model="ir.rule">
        <field name="name">Evidence Album Item: reviewer access</field>
        <field name="model_id" ref="model_wd_evidence_album_item"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_album_reviewer'))]"/>
    </record>

    <record id="rule_item_manager_all" model="ir.rule">
        <field name="name">Evidence Album Item: manager access</field>
        <field name="model_id" ref="model_wd_evidence_album_item"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_album_manager'))]"/>
    </record>

    <record id="rule_source_config_manager" model="ir.rule">
        <field name="name">Evidence Source Configuration: manager access</field>
        <field name="model_id" ref="model_wd_evidence_album_source_config"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_album_manager'))]"/>
    </record>
</odoo>
