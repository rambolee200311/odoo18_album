<odoo>
    <record id="view_evidence_album_list" model="ir.ui.view">
        <field name="name">wd.evidence.album.list</field>
        <field name="model">wd.evidence.album</field>
        <field name="arch" type="xml">
            <list default_order="create_date desc">
                <field name="album_number"/>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="state"/>
                <field name="valid_until"/>
                <field name="published_at"/>
                <field name="reviewed_by"/>
            </list>
        </field>
    </record>

    <record id="view_evidence_album_form" model="ir.ui.view">
        <field name="name">wd.evidence.album.form</field>
        <field name="model">wd.evidence.album</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_preview_portal" type="object"
                            string="Preview Portal"
                            invisible="state not in ['draft', 'confirmed']"/>
                    <button name="action_confirm" type="object"
                            string="Confirm" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Back to Draft" groups="wd_evidence_album.group_album_reviewer"
                            invisible="state != 'confirmed'"/>
                    <button name="action_publish" type="object"
                            string="Publish" class="btn-primary"
                            groups="wd_evidence_album.group_album_reviewer"
                            invisible="state != 'confirmed'"/>
                    <button name="action_unpublish" type="object"
                            string="Back to Confirmed" groups="wd_evidence_album.group_album_reviewer"
                            invisible="state != 'published'"/>
                    <button name="action_revoke" type="object"
                            string="Revoke" groups="wd_evidence_album.group_album_reviewer"
                            invisible="state != 'published'"/>
                    <button name="action_reset_token" type="object"
                            string="Reset Token" groups="wd_evidence_album.group_album_reviewer"
                            invisible="state != 'published'"/>
                    <button name="action_open_extend_validity" type="object"
                            string="Extend Validity"
                            groups="wd_evidence_album.group_album_manager"
                            invisible="state != 'published'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,published,revoked"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="album_number"/></h1>
                    </div>
                    <group>
                        <group string="Basic Information">
                            <field name="name"/>
                            <field name="customer_id"/>
                            <field name="description"/>
                        </group>
                        <group string="Status Information">
                            <field name="state" readonly="1"/>
                            <field name="valid_until" readonly="state == 'published'"/>
                            <field name="published_at" readonly="1"/>
                            <field name="revoked_at" readonly="1"/>
                            <field name="reviewed_by" readonly="1"/>
                            <field name="token" readonly="1" groups="wd_evidence_album.group_album_reviewer"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Pages">
                            <div class="oe_button_box">
                                <button name="action_open_create_page_from_source" type="object"
                                        string="Create Page from Source" class="btn-primary"
                                        invisible="state != 'draft'"/>
                                <button name="action_open_create_page_upload" type="object"
                                        string="Create Page &amp; Upload Media" class="btn-primary"
                                        invisible="state != 'draft'"/>
                            </div>
                            <div class="alert alert-info" invisible="id">
                                Save the album before adding pages or media.
                            </div>
                            <field name="page_ids" mode="list,form" readonly="state != 'draft'">
                                <list create="0" delete="0">
                                    <field name="sequence" widget="handle"/>
                                    <field name="title"/>
                                    <field name="description"/>
                                    <button name="action_open_form" type="object"
                                            string="Open" icon="fa-external-link"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_evidence_album_search" model="ir.ui.view">
        <field name="name">wd.evidence.album.search</field>
        <field name="model">wd.evidence.album</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="customer_id"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_published" string="Published" domain="[('state', '=', 'published')]"/>
                <filter name="filter_expiring" string="Has Expiry" domain="[('valid_until', '!=', False)]"/>
                <filter name="filter_my_albums" string="My Albums" domain="[('create_uid', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_customer" string="Customer" context="{'group_by': 'customer_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_evidence_album" model="ir.actions.act_window">
        <field name="name">Media Albums</field>
        <field name="res_model">wd.evidence.album</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_evidence_album_search"/>
    </record>
</odoo>
