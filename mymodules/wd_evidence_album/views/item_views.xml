<odoo>
    <record id="view_evidence_album_item_form" model="ir.ui.view">
        <field name="name">wd.evidence.album.item.form</field>
        <field name="model">wd.evidence.album.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="page_id" readonly="1"/>
                        <field name="album_id" readonly="1"/>
                        <field name="attachment_id"/>
                        <field name="media_type"/>
                        <field name="availability_state" readonly="1"/>
                        <field name="source_type"/>
                        <field name="source_model" readonly="1"/>
                        <field name="source_record_id" readonly="1"/>
                        <field name="source_field_name" readonly="1"/>
                        <field name="sequence"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_evidence_album_item_list" model="ir.ui.view">
        <field name="name">wd.evidence.album.item.list</field>
        <field name="model">wd.evidence.album.item</field>
        <field name="arch" type="xml">
            <list default_order="sequence, id">
                <field name="sequence"/>
                <field name="page_id"/>
                <field name="attachment_id"/>
                <field name="media_type"/>
                <field name="availability_state"/>
                <field name="source_type"/>
            </list>
        </field>
    </record>
</odoo>
