<templates xml:space="preserve">
    <t t-name="wd_evidence_album.EvidencePageMediaGallery">
        <div class="o_evidence_page_media_gallery">
            <div t-if="!items.length" class="alert alert-info mb-0">
                No media has been added to this page.
            </div>
            <div t-else="" class="row g-3">
                <t t-foreach="items" t-as="item" t-key="item.id">
                    <div class="col-6 col-md-4 col-xl-3">
                        <div class="card h-100 shadow-sm">
                            <div class="o_evidence_page_media_gallery__thumb"
                                 t-on-click="() => this.openPreview(item)">
                                <video t-if="isVideo(item)" t-att-src="getUrl(item.attachmentId)"
                                       class="w-100 h-100" muted="muted" preload="metadata"/>
                                <img t-else="" t-att-src="getUrl(item.attachmentId)"
                                     t-att-alt="item.note || item.name"
                                     class="w-100 h-100 object-fit-cover"/>
                                <div class="o_evidence_page_media_gallery__play"
                                     t-if="isVideo(item)" aria-hidden="true">
                                    <i class="fa fa-play"/>
                                </div>
                            </div>
                            <div class="card-body p-2">
                                <div class="small text-truncate" t-att-title="item.note || item.name">
                                    <t t-esc="item.note || item.name || 'Media'"/>
                                </div>
                                <div class="d-flex gap-1 mt-2">
                                    <button type="button" class="btn btn-sm btn-primary"
                                            t-on-click="() => this.openPreview(item)"
                                            title="Enlarge" aria-label="Enlarge media">
                                        <i class="fa fa-search-plus me-1" aria-hidden="true"/>Enlarge
                                    </button>
                                    <a class="btn btn-sm btn-secondary"
                                       t-att-href="getUrl(item.attachmentId, true)"
                                       title="Download" aria-label="Download media">
                                        <i class="fa fa-download me-1" aria-hidden="true"/>Download
                                    </a>
                                    <button t-if="canEdit" type="button" class="btn btn-sm btn-danger"
                                             t-on-click="() => this.removeMedia(item)"
                                             title="Delete" aria-label="Delete media">
                                         <i class="fa fa-trash me-1" aria-hidden="true"/>Delete
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
            <div t-if="state.preview" class="o_evidence_page_media_gallery__modal"
                 role="dialog" aria-modal="true" t-on-click="this.closePreview">
                <div class="o_evidence_page_media_gallery__modal_content" t-on-click.stop="() => {}">
                    <button type="button" class="btn btn-light o_evidence_page_media_gallery__close"
                            t-on-click="this.closePreview" aria-label="Close preview">×</button>
                    <video t-if="isVideo(state.preview)" t-att-src="getUrl(state.preview.attachmentId)"
                           controls="controls" autoplay="autoplay" playsinline="playsinline"/>
                    <img t-else="" t-att-src="getUrl(state.preview.attachmentId)"
                         t-att-alt="state.preview.note || state.preview.name"
                         t-on-click.stop="() => {}"/>
                </div>
            </div>
            <div t-if="canEdit and hasRecordId" class="mt-3">
                <FileInput acceptedFileExtensions="'image/*,video/*'"
                           multiUpload="true"
                           onUpload.bind="onFileUploaded"
                           resModel="props.record.resModel"
                           resId="props.record.resId">
                    <button type="button" class="btn btn-primary">
                        <i class="fa fa-paperclip me-1" aria-hidden="true"/>
                        Choose photos and videos
                    </button>
                </FileInput>
            </div>
            <div t-if="canEdit and !hasRecordId" class="alert alert-info mt-3 mb-0">
                Save the Page before uploading media.
            </div>
        </div>
    </t>
</templates>
